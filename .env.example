# Get free API keys:
# Groq (ASR + LLM):  https://console.groq.com/  — free tier
# Sarvam (TTS):      https://dashboard.sarvam.ai  — 1000 free credits
# Twilio (WhatsApp): https://console.twilio.com/  — free trial
# Google Sheets:     https://console.cloud.google.com/  — free tier

# ── ASR + LLM (Groq) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# ── TTS (Sarvam Bulbul v3) ────────────────────────────────────────────────
SARVAM_API_KEY=
# Defaults are Sarvam's own per-language picks (chosen on character error rate):
#   hi→priya, te→neha, en→ishita
# Audition all 37 speakers at /static/sarvam_demo.html before changing these.
# TTS_VOICE_HI=priya
# TTS_VOICE_TE=neha
# TTS_VOICE_EN=ishita

# Speech speed, 0.5–2.0. Bulbul v3 is trained at 1.0, which is where it sounds
# human — this used to default to 1.4 and the agent sounded rushed. Telugu packs
# more syllables per word, so it needs a shade slower again. Tune by ear.
# TTS_PACE=1.0
# TTS_PACE_TE=0.95

# Prosody variation (v3 only, 0.01–2.0). Low reads flat and identical every
# turn; high wanders in pitch mid-sentence.
# TTS_TEMPERATURE=0.6

# Streaming. /stream relays one continuous Sarvam WebSocket per reply so prosody
# carries across sentences. min_buffer trades time-to-first-audio against how
# much text the prosody model sees at once.
# TTS_MIN_BUFFER=50
# TTS_MAX_CHUNK=250
# TTS_SAMPLE_RATE=24000

# Silence gate: trims Sarvam's leading/trailing silence (~950 ms per reply) while
# keeping the pauses between sentences. Raise to trim harder, lower if soft
# syllable onsets get clipped.
# TTS_SILENCE_RMS=150

# Spell ordinary numbers out as words. Off by default — v3 reads digits better
# itself, and this pass turned "10:30" into "दस:तीस". Phone numbers are always
# read digit by digit regardless.
# TTS_SPELL_NUMBERS=0

# ── LiveKit (real-time voice pipeline) ─────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Lead Capture: Google Sheets (optional) ──────────────────────────────────
# 1. Create service account at https://console.cloud.google.com/apis/credentials
# 2. Download JSON and put path here
# 3. Share your Google Sheet with the service account email
# GOOGLE_SHEETS_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SHEET_ID=your-google-sheet-id

# ── Lead Capture: WhatsApp (optional) ───────────────────────────────────────
# Get Twilio number with WhatsApp capability at https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+91<owner-phone-number>
