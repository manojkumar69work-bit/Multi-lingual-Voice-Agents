# Get free API keys:
# Groq (ASR + LLM):  https://console.groq.com/  — free tier
# Sarvam (TTS):      https://dashboard.sarvam.ai  — 1000 free credits
# Twilio (WhatsApp): https://console.twilio.com/  — free trial
# Google Sheets:     https://console.cloud.google.com/  — free tier

# ── ASR + LLM (Groq) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# ── TTS (Sarvam Bulbul v3) ────────────────────────────────────────────────
SARVAM_API_KEY=
# Defaults: hi→roopa, te→roopa, en→ishita
# Audition all 37 speakers at /static/sarvam_demo.html before changing these.
# TTS_VOICE_HI=roopa
# TTS_VOICE_TE=roopa
# TTS_VOICE_EN=ishita

# Speech speed. Telugu packs more syllables per word, so it needs a lower value
# than Hindi or it slurs. Tune by ear.
# TTS_PACE=1.4
# TTS_PACE_TE=1.15

# ── LiveKit (real-time voice pipeline) ─────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Lead Capture: Google Sheets (optional) ──────────────────────────────────
# 1. Create service account at https://console.cloud.google.com/apis/credentials
# 2. Download JSON and put path here
# 3. Share your Google Sheet with the service account email
# GOOGLE_SHEETS_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SHEET_ID=your-google-sheet-id

# ── Lead Capture: WhatsApp (optional) ───────────────────────────────────────
# Get Twilio number with WhatsApp capability at https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_TO=whatsapp:+91<owner-phone-number>
