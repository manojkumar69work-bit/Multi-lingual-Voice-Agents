# Copy to .env on the server and fill every value. Nothing here is optional
# except the lead-delivery block.
DOMAIN=voice.example.com

# LiveKit keys: any long random pair. Generate: openssl rand -hex 16 ; openssl rand -hex 32
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Session signing. Generate: openssl rand -hex 32
SESSION_SECRET=
# Admin login. Hash: python -c "import passwords; print(passwords.hash_password('your-password'))"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Speech and language models
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Lead delivery (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEET_ID=
