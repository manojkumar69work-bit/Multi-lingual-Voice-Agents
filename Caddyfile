# TLS for the portals and the LiveKit signalling endpoints, one domain.
# DOMAIN comes from the environment (docker-compose.prod.yml).
{$DOMAIN} {
	encode zstd gzip

	# LiveKit signalling (WebSocket) and its Twirp API share the domain.
	@livekit path /rtc* /twirp* /validate*
	reverse_proxy @livekit livekit:7880

	reverse_proxy server:8000
}
