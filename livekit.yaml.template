# Rendered into livekit.yaml at container start by `scripts/entrypoint.sh livekit`.
# ${LIVEKIT_API_KEY} / ${LIVEKIT_API_SECRET} come from the environment, never from git.
port: 7880
bind_addresses:
  - "0.0.0.0"
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
keys:
  "${LIVEKIT_API_KEY}": "${LIVEKIT_API_SECRET}"
logging:
  level: info
redis:
  address: "redis:6379"
